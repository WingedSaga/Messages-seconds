# Порт HTTP-сервера. У сайта «НОВОСТИ СЕКУНДЫ» занят 4000.
PORT=4100

# Окружение: development | production
NODE_ENV=development

# Тот же проект Supabase, что и у сайта: таблица users общая,
# аккаунт у человека один.
SUPABASE_URL=https://your-project-ref.supabase.co
# Сервисный ключ. Используется только на сервере, никогда не публикуется в клиенте.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Бакет Supabase Storage для вложений. Создайте его публичным.
SUPABASE_CHAT_BUCKET=chat-media
# Предел одного вложения в байтах (по умолчанию 25 МБ)
SUPABASE_CHAT_MAX_BYTES=26214400

# Секрет подписи JWT. ОБЯЗАН совпадать с секретом сайта — тогда вход на сайте
# будет и входом в переписку. Разные значения означают второй вход.
JWT_SECRET=change-me-to-a-long-random-string
# Срок жизни токена. В мессенджере дольше, чем на сайте: перелогин посреди
# переписки раздражает сильнее, чем на странице новостей.
JWT_EXPIRES_IN=30d

# Разрешённые источники запросов, через запятую
CORS_ORIGIN=http://localhost:5174,https://wingedsaga.github.io
